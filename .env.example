# GEMINI_API_KEY: Required for live Gemini AI calls.
# When absent, every AI route serves a deterministic local fallback instead.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Gemini model id. Defaults to gemini-2.5-flash when unset.
GEMINI_MODEL="gemini-2.5-flash"

# --- Multi-provider AI (Phase 1) ---
# AI_PROVIDER: pin the LLM backend — "zen" | "groq" | "claude" | "gemini" | "local".
# Leave empty to auto-select the first available (zen → groq → claude → gemini).
AI_PROVIDER=""

# ANTHROPIC_API_KEY / CLAUDE_MODEL: enable the Claude provider.
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-sonnet-5"

# GROQ_API_KEY / GROQ_MODEL: enable the Groq provider (OpenAI-compatible,
# fetch-only, no SDK). Get a key at the Groq console.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
# GROQ_BASE_URL: override, default "https://api.groq.com/openai/v1".
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# OPENCODE_API_KEY: enable the OpenCode Zen gateway provider (fetch-only).
# OPENCODE_ZEN_API_KEY is accepted as an alias. Get a key at opencode.ai/auth.
OPENCODE_API_KEY=""
# ZEN_MODEL: Zen model id, default "gemini-3-flash". Verify the model exists
# with GET <ZEN_BASE_URL>/models using your key before relying on it.
ZEN_MODEL="gemini-3-flash"
# ZEN_BASE_URL / ZEN_CHAT_PATH: overrides, defaults below.
ZEN_BASE_URL="https://opencode.ai/zen/v1"
ZEN_CHAT_PATH="/chat/completions"

# --- Sandbox tool execution (Phase 1) ---
# SANDBOX_MODE: how security tools run. FAIL-CLOSED by default.
#   "auto" (default) / "docker" — run in the Docker sandbox. If the daemon is
#       unreachable the request FAILS with 503 NOT_AVAILABLE. It never silently
#       downgrades to simulated output.
#   "simulate" (alias: "local") — explicitly opt into the deterministic
#       simulator. Output is prefixed "SIMULATED — NOT A REAL RESULT" and is
#       never evidence of anything. Use for offline development only.
SANDBOX_MODE="auto"
# SANDBOX_DOCKER_PING_TIMEOUT_MS: deadline for the daemon reachability probe.
SANDBOX_DOCKER_PING_TIMEOUT_MS="2000"
# SANDBOX_DOCKER_PROBE_TTL_MS: how long a reachability result is cached.
SANDBOX_DOCKER_PROBE_TTL_MS="30000"
# SANDBOX_NETWORK_NAME: dedicated Docker network for tool containers. Created
# automatically. Attach lab target containers to it so tools can reach them
# without sharing the host's default bridge.
SANDBOX_NETWORK_NAME="cyberguard_sandbox"
# SANDBOX_ALLOW_EGRESS: "true" lets the sandbox network route to the internet.
# Default (false) makes the network `internal`, so a scanner physically cannot
# reach anything outside the lab.
SANDBOX_ALLOW_EGRESS="false"
# Container images used by the tool adapters.
NMAP_IMAGE="instrumentisto/nmap:latest"
SUBFINDER_IMAGE="projectdiscovery/subfinder:latest"
NUCLEI_IMAGE="projectdiscovery/nuclei:latest"
SEMGREP_IMAGE="semgrep/semgrep:latest"
TRIVY_IMAGE="aquasec/trivy:latest"

# The following four images are NOT verified official images — there is no
# single canonical Docker Hub image for these tools. Build/pin and review one
# yourself before relying on it in production; the defaults below are a
# starting point, not a guarantee.
WFUZZ_IMAGE="wfuzz/wfuzz:latest"
THEHARVESTER_IMAGE="theharvester/theharvester:latest"
CTFR_IMAGE="ghcr.io/unapibageek/ctfr:latest"
XSSTRIKE_IMAGE="ghcr.io/s0md3v/xsstrike:latest"

# SQLMAP_IMAGE: container image for the sqlmap adapter. sqlmap is HIGH risk —
# the risk policy engine requires explicit human approval before it will run,
# regardless of this image.
SQLMAP_IMAGE="sqlmapproject/sqlmap:latest"

# SANDBOX_WORKSPACE_ROOT: the ONLY directory code-scanning tools may read.
# A path is mountable only when its real path (symlinks resolved) is inside
# this root, and it is always mounted read-only.
SANDBOX_WORKSPACE_ROOT="./workspaces"

# PORT: TCP port the server listens on. Defaults to 7799 when unset.
PORT="7799"

# APP_URL: The URL where this app is hosted (self-referential links / callbacks).
APP_URL="MY_APP_URL"

# APP_ACCESS_KEY: Shared secret protecting all /api/* routes (except /api/health)
# via the x-api-key header. When set, requests without a matching header get 401.
# IMPORTANT: if you set this, you MUST also set VITE_APP_ACCESS_KEY (below) to the
# same value so the frontend attaches the header — otherwise the SPA breaks.
APP_ACCESS_KEY="MY_APP_ACCESS_KEY"

# VITE_APP_ACCESS_KEY: Build-time copy of APP_ACCESS_KEY exposed to the browser
# bundle so the SPA can send the x-api-key header. Leave empty for open-access
# (development) mode. Note: this value ships in client JS, so treat the key as a
# low-value gate (rate-limit / bot filter), not a real auth boundary.
VITE_APP_ACCESS_KEY=""

# --- Risk policy & approvals (Phase 3) ---
# ENABLE_CRITICAL_TOOLS: comma-separated tool ids permitted despite being
# classified CRITICAL. Empty (the default) keeps every CRITICAL tool disabled.
ENABLE_CRITICAL_TOOLS=""
# APPROVAL_TTL_MS: how long an approval request / granted token stays valid.
APPROVAL_TTL_MS="900000"

# --- Persistence (Phase 11) ---
# DATABASE_URL: Postgres connection string. When SET, the platform FAILS TO
# START if the server is unreachable — it will not quietly run in memory and
# lose findings and audit records. Leave EMPTY to run explicitly in memory.
DATABASE_URL=""
# DATABASE_SSL: "false" disables TLS (local dev only). Defaults to enabled.
DATABASE_SSL="true"
# DATABASE_SSL_STRICT: "false" accepts a self-signed server certificate.
DATABASE_SSL_STRICT="true"
DATABASE_POOL_MAX="10"
DATABASE_CONNECT_TIMEOUT_MS="5000"

# --- Identities and roles (Phase 11) ---
# API_PRINCIPALS: per-key identities, comma-separated, as `id:roles:secret`
# with roles joined by "|". Roles: admin | operator | approver | viewer
# (admin implies all). Takes precedence over APP_ACCESS_KEY.
#   API_PRINCIPALS="alice:admin|approver:s3cret,scanner-bot:operator:othersecret"
# IMPORTANT: approving a high-risk tool requires the "approver" role. The shared
# APP_ACCESS_KEY deliberately cannot approve — a key everyone holds is not a
# person, so it must not satisfy a human-approval requirement.
API_PRINCIPALS=""
